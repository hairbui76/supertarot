# Secrets — never commit. .env holds real Telegram and LLM API keys.
.env
*.jks
*.keystore
key.properties

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Generated data. `data/output` and `data/images` are committed because the
# whole pipeline and the Android app build from them; everything else here is
# either re-crawlable or derived, and CI regenerates what it needs.
data/raw/
data/cache/
data/cheatsheets/
data/embeddings/
data/bot_state/

# Flutter / Android
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/

# Generated by `python mobile/tools/prepare_assets.py` from data/output +
# data/images. Regenerated in CI, so it stays out of history.
mobile/assets/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.log

# Astro site. Everything under src/data and the card art in public/ is
# generated by `python web/tools/prepare_web_assets.py`, same as the app's
# assets, so CI rebuilds it rather than reading it from history.
web/node_modules/
web/dist/
web/.astro/
web/src/data/
web/public/cards/
web/public/logo.png
web/public/favicon.png
web/public/og.png
web/public/apple-touch-icon.png
web/public/icon-*.png
