---
// The quiz used to live at /draw/. Links to it are already out there - shared
// URLs and the shortcuts of PWAs installed before the rename - so the old path
// forwards to /quiz/ rather than 404ing. "Draw" now means the spread, but that
// page has its own URL so the two never get confused.
import { href, LANGS, type Lang } from '../../lib/cards';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const target = href(import.meta.env.BASE_URL, lang, 'quiz');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target} />
    <title>SuperTarot</title>
    <!-- In the head, so the browser leaves before painting anything. -->
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body></body>
</html>
