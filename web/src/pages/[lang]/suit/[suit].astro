---
import Base from '../../../layouts/Base.astro';
import CardGrid from '../../../components/CardGrid.astro';
import {
  cardsForSuit,
  href,
  LANGS,
  SUITS,
  suitLabel,
  type Lang,
} from '../../../lib/cards';
import { t } from '../../../lib/i18n';
import { icons } from '../../../lib/icons';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    SUITS.map((suit) => ({ params: { lang, suit: suit.key } })),
  );
}

const lang = Astro.params.lang as Lang;
const suitKey = Astro.params.suit as string;
const suit = SUITS.find((item) => item.key === suitKey)!;
const strings = t(lang);
const base = import.meta.env.BASE_URL;
const list = cardsForSuit(lang, suit);
const label = suitLabel(suit, lang);
---

<Base
  lang={lang}
  title={`${label} — ${strings.siteTitle}`}
  description={`${label}: ${list.length} ${strings.cardCount}. ${strings.metaDescription}`}
  altPath={`suit/${suit.key}`}
>
  <div class="wrap">
    <a class="back" href={href(base, lang)}>
      <span set:html={icons.arrowLeft} />
      {strings.backToSuits}
    </a>

    <header class="suit-head" style={`--accent:${suit.accent}`}>
      <h1>{label}</h1>
      <span class="chip chip--fill" style={`background:${suit.accent}`}>
        {list.length} {strings.cardCount}
      </span>
    </header>

    <CardGrid lang={lang} cards={list} searchable />
  </div>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 8px 14px;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-weight: 900;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow);
  }

  .back :global(svg) {
    width: 16px;
    height: 16px;
  }

  .suit-head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    text-transform: uppercase;
  }
</style>
